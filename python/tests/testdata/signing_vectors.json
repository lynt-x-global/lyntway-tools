      "note": "the common case: JSON body, content-digest covered",
      "request": {
        "method": "POST",
        "url": "https://govern.lyntway.com/v1/govern",
        "body": "{\"chain_id\": \"ws_acme\", \"content\": \"Customer priya@acme.com paid with 4111111111111111.\", \"actor\": {\"type\": \"agent\", \"id\": \"agent_support\", \"source\": \"lyntway_key\"}}"
      },
      "created": 1757203200,
      "expires": 1757203500,
      "nonce": "c2lnbmluZy12ZWN0b3Jz",
      "verify_at": 1757203210,
      "expected": {
        "authority": "govern.lyntway.com",
        "path": "/v1/govern",
        "content_digest": "sha-256=:ljdbxIE/WF7zeP1ZPOuWh6aC7t3heDlmoYsqaQBiUNo=:",
        "signature_input": "sig1=(\"@method\" \"@authority\" \"@path\" \"content-digest\");created=1757203200;expires=1757203500;nonce=\"c2lnbmluZy12ZWN0b3Jz\";keyid=\"key_5f3a9c1e7b2d4680a1b2c3d4e5f60718\";alg=\"ed25519\";tag=\"web-bot-auth\"",
